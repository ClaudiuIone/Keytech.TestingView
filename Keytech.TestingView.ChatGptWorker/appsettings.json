    // low, medium, high. Low is shorter; high allows longer and more detailed responses.
    "TextVerbosity": "low",
    // auto, low, high. Low is cheaper/faster but lower resolution; high reads chart details better; auto lets the model choose.
    "ImageDetail": "high",
    // Maximum output tokens for the analysis note. Increase for longer narratives, decrease to cap cost/output length.
    "MaxOutputTokens": 20000,
    // Number of retry attempts for rate limits and transient OpenAI 5xx errors.
    "MaxRetries": 3,
    // Base retry delay in milliseconds. Retries use exponential backoff unless OpenAI returns Retry-After.
    "RetryBaseDelayMilliseconds": 1000
  },
  "TestingView": {
    "ImageApiUrl": "https://api.testingview.com/gpt/image",
    "ImageRemoveUrl": "https://api.testingview.com/gpt/image-remove",
