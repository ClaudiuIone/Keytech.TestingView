<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<system.webServer>
		<handlers>
			<add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
		</handlers>
		<aspNetCore processPath=".\Keytech.TestingView.API.exe" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
		<rewrite>
			<rules>
				<rule name="Root2JS" stopProcessing="true">
					<match url="^$" />
					<conditions>
						<add input="{HTTP_HOST}" pattern="^js\.testingview\.com$" />
					</conditions>
					<action type="Redirect" url="https://{HTTP_HOST}/js/testingview.js?v=1" redirectType="Permanent" />
				</rule>
			</rules>
		</rewrite>
		<cors enabled="true" failUnlistedOrigins="true">
			<!-- Repeat <add> for each allowed origin -->
			<add origin="https://*.tradingview.com" allowCredentials="true" maxAge="3600">
				<!-- Allow requested headers/methods from browser -->
				<allowHeaders allowAllRequestedHeaders="true" />
				<allowMethods>
					<add method="GET" />
					<add method="POST" />
					<add method="PUT" />
					<add method="DELETE" />
					<add method="OPTIONS" />
				</allowMethods>
				<!-- (Optional) expose extra response headers to JS -->
				<exposeHeaders>
					<add header="Content-Length" />
					<add header="Content-Range" />
				</exposeHeaders>
			</add>
		</cors>

		<!-- (Optional) add Vary: Origin so caches behave correctly -->
		<httpProtocol>
			<customHeaders>
				<add name="Vary" value="Origin" />
				<add name="Cache-Control" value="no-store, no-cache, must-revalidate, max-age=0" />
				<add name="Pragma" value="no-cache" />
				<add name="Expires" value="0" />
			</customHeaders>
		</httpProtocol>
		<caching enabled="false" enableKernelCache="false">
			<profiles>
				<add extension=".js" policy="DisableCache" kernelCachePolicy="DisableCache" />
			</profiles>
		</caching>
		<!-- Turn off client caching for static files in this folder -->
		<staticContent>
			<clientCache cacheControlMode="DisableCache" />
		</staticContent>
	</system.webServer>
</configuration>
