    <SiteUrlToLaunchAfterPublish>js.testingview.com</SiteUrlToLaunchAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <ProjectGuid>3ba1ea7b-544a-405d-9363-22760aef0fbf</ProjectGuid>
    <SelfContained>false</SelfContained>
